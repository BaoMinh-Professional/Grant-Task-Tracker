{
  "ConnectionStrings": { "GrantTracker": "Data Source=App_Data/grant-tracker.db" },
  "BusinessTime": { "TimeZoneId": "Asia/Singapore" },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "LogFile": { "Path": "logs/grant-tracker-.json", "RetainedFileCountLimit": 14 },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}
